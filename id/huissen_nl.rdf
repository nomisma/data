    <nmo:Mint rdf:about="http://nomisma.org/id/huissen_nl">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <skos:prefLabel xml:lang="nl">Huissen</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Huissen</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Huissen</skos:prefLabel>
        <skos:definition xml:lang="en">Huissen (city in the municipality of Lingewaard in the province of Gelderland, the Netherlands) received city rights in 1384 and was a member of the Hanseatic League. Coins were struck by various counts and dukes of Cleves, including Diederik VI (1202–1260), Otto III (1305–1311), Adolf II (1417–1448), and later Georg Wilhelm (1624–1640). Mechteld of Gelre, widow of John of Cleves, issued coins there with the inscription MONETA DE HVVSCIENSIS and died in Huissen in 1384. A series of Huissen coins was prohibited in the Netherlands in 1625 due to poor quality. Emergency money was issued at the beginning of World War II, dated 14 May to 1 June 1940.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Muntplaatsen"/>
