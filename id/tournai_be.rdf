    <nmo:Mint rdf:about="http://nomisma.org/id/tournai_be">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <skos:prefLabel xml:lang="nl">Doornik</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Tournai</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Doornik</skos:prefLabel>
        <skos:definition xml:lang="en">In (Tournai (Doornik, province of Hainaut, Belgium), Merovingian coins were produced in the 6th-7th century, followed by some Carolingian issues and - in the 12th century - for the bisshop's of Tournai. In the period 1187-1507 and 1513-1518 there was a French royal Mint, in 1513-1518 an English royal Mint, in 1578-1581 a Mint during the revolt against Spain, followed by a royal Spanish Mint 1581-1667. emergency money were produced in 1521, 1581 and 1709. In Tournai also medals are produced.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Muntplaatsen"/>
        <geo:location rdf:resource="http://nomisma.org/id/tournai_be#this"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/medieval_european_numismatics"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/medieval_belgian_numismatics"/>
        <skos:changeNote rdf:resource="http://nomisma.org/id/tournai_be#provenance"/>
    </nmo:Mint>
   
   
   
