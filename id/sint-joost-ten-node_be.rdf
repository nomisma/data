        <skos:prefLabel xml:lang="de">Sint-Joost-ten-Node</skos:prefLabel>
        <skos:definition xml:lang="en">Sint-Joost-ten-Node (French: Saint-Josse-ten-Noode) is a municipality belonging to Brussels-Capital, where seven issues of emergency paper money were issued during the First World War: five undated, one valid until 30 June 1919 and one dated 15 July 1915.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Papiergeldplaatsen"/>
