        <skos:prefLabel xml:lang="nl">Aalst</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Aalst</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Aalst</skos:prefLabel>
        <skos:definition xml:lang="en">From the 13th century onwards, the medieval mint of Aalst (Alost, province of East-Flanders, Belgium) produced coins in its own right and for the Flemish counts until 1346. During the First World War, emergency paper money has been produced in Aalst too.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Muntplaatsen"/>
