    <nmo:Collection rdf:about="http://nomisma.org/id/blumenstein">
        <skos:prefLabel xml:lang="en">Blumenstein Museum</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Museum Blumenstein</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Museum Blumenstein</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Museum BLumenstein</skos:prefLabel>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:definition xml:lang="en">The Blumenstein Museum, the municipal museum of Solothurn in Switzerland, has its origins in the former collection of the Solothurn City Library. Since 1952, it has been housed in Blumenstein Castle.
The numismatic collection dates back to the 18th century and comprises over 10,000 items. The focus is on coins and medals minted in Solothurn. A particular highlight is the collection of over 500 dies from the Solothurn mint.</skos:definition>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
