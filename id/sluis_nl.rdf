    <nmo:Mint rdf:about="http://nomisma.org/id/sluis_nl">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <skos:prefLabel xml:lang="nl">Sluis</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Sluis</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Sluis</skos:prefLabel>
        <skos:definition xml:lang="en">Sluis, a former mint in Zeeuws-Vlaanderen, now the municipality of Sluis-Aardenburg in the province of Zeeland, the Netherlands, where coins were struck in 1492 in the name of Philip the Fair by rebels expelled from Ghent who were opposing the regent acting on behalf of his son, the Roman Catholic King Maximilian of Austria. Double and single stuivers were minted, with the obverse featuring a lion in front of Sluis Castle, or Sluis Castle on a trefoil; the reverse shows the Austrian-Burgundian coat of arms on a cross, surrounded by the letters SLVS. According to illustrations in 16th-century coin catalogues, Philippus guilders were also minted, but these have not yet been found.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Muntplaatsen"/>
        <geo:location rdf:resource="http://nomisma.org/id/sluis_nl#this"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/medieval_european_numismatics"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/modern_european_numismatics"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/medieval_dutch_numismatics"/>
        <skos:changeNote rdf:resource="http://nomisma.org/id/sluis_nl#provenance"/>
    </nmo:Mint>
   
   
   
