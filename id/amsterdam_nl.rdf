    <nmo:Mint rdf:about="http://nomisma.org/id/amsterdam_nl">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <skos:prefLabel xml:lang="nl">Amsterdam</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Amsterdam</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Amsterdam</skos:prefLabel>
        <skos:definition xml:lang="en">In Amsterdam (province of North Holland, the Netherlands), coins were produced in 1578 (during a siege) and in 1672-1673, 1814-1816 (copper coins by Hendrikus de Heus (1764-1836)). In the period 1824-1837 followed by private coins for the 'Werkhuis' (a place where poverished people had to work). In the end of the 18th century recepissen were issued, followed in 1914 with emergency paper money. In the town many medal artists were and are active.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Muntplaatsen"/>
        <geo:location rdf:resource="http://nomisma.org/id/amsterdam_nl#this"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/modern_european_numismatics"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/modern_dutch_numismatics"/>
        <skos:changeNote rdf:resource="http://nomisma.org/id/amsterdam_nl#provenance"/>
    </nmo:Mint>
