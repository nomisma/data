        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/medieval_dutch_numismatics"/>
        <skos:changeNote rdf:resource="http://nomisma.org/id/hasselt_nl#provenance"/>
    </nmo:Mint>
   
   
   
