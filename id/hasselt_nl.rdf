    <nmo:Mint rdf:about="http://nomisma.org/id/hasselt_nl">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <skos:prefLabel xml:lang="nl">Hasselt</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Hasselt</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Hasselt</skos:prefLabel>
        <skos:definition xml:lang="en">Hasselt (former municipality, present day village in the province of Overijssel, the Netherlands) received city rights in 1252 and joined the Hanseatic League. A mint was active there from around 1415 under the bishops of Utrecht—Frederik van Blankenheim, Rudolf van Diepholt, and Frederik van Baden—striking mainly silver and possibly anonymous gold. After incorporation into the Habsburg domains, a Burgundian-Austrian mint operated briefly (1529–1533). Coining resumed under Philip II from 1562 to 1567, before moving to Utrecht. A provincial Overijssel mint functioned there from 1578 to 1582, issuing silver statendaalders and copper duiten, followed by local small change (1582–1584) with counterstamped threeplakken.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Muntplaatsen"/>
        <geo:location rdf:resource="http://nomisma.org/id/hasselt_nl#this"/>
