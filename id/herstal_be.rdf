    <nmo:Mint rdf:about="http://nomisma.org/id/herstal_be">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <skos:prefLabel xml:lang="nl">Herstal</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Herstal</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Herstal</skos:prefLabel>
        <skos:definition xml:lang="en">Herstal (former Brabantine lordship and mint, present-day municipality in the province of Liège, Belgium) passed to Godfrey I of Leuven in 1235 and returned to the dukes of Brabant after 1339. Coins were struck under the dukes of Brabant and the lords of Herstal, including Godfrey I (1095–1140), Henry I (1190–1235), Henry I of Leuven (1253–1285), John I of Leuven (1285–1309), Félicité of Luxembourg (1309–1318, as guardian of John II), John II of Leuven (1309–1324), and John III, Duke of Brabant (1312–1355).</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Muntplaatsen"/>
        <geo:location rdf:resource="http://nomisma.org/id/herstal_be#this"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/medieval_european_numismatics"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/medieval_belgian_numismatics"/>
        <skos:changeNote rdf:resource="http://nomisma.org/id/herstal_be#provenance"/>
    </nmo:Mint>
   
   
   
