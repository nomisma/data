        <skos:prefLabel xml:lang="nl">Amersfoort</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Amersfoort</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Amersfoort</skos:prefLabel>
        <skos:definition xml:lang="en">In Amersfoort (province of Utrecht, the Netherlands) coins were produced for the bishop of Utrecht (1364-1371) and under the German occupation in 1944 payment tokens for the Politisches Durchgangslager Amersfoort. In the town, also medals were and are produced.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Muntplaatsen"/>
