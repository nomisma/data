        <skos:prefLabel xml:lang="nl">Leuven</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Leuven</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Leuven</skos:prefLabel>
        <skos:definition xml:lang="en">In Leuven (province of Flemish-Brabant), coins were produced in the Carolingian era for the county of Leuven and for Brabant. In Leuven, also medals are produced. Coins were produced up to 1489. During World War I, emergency banknotes were issued.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Muntplaatsen"/>
