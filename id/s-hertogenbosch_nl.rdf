        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/medieval_dutch_numismatics"/>
        <skos:changeNote rdf:resource="http://nomisma.org/id/s-hertogenbosch_nl#provenance"/>
    </nmo:Mint>
   
   
   
