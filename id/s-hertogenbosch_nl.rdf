    <nmo:Mint rdf:about="http://nomisma.org/id/s-hertogenbosch_nl">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <skos:prefLabel xml:lang="nl">'s-Hertogenbosch (Den Bosch)</skos:prefLabel>
        <skos:prefLabel xml:lang="en">'s-Hertogenbosch (Den Bosch)</skos:prefLabel>
        <skos:prefLabel xml:lang="de">'s-Hertogenbosch (Den Bosch)</skos:prefLabel>
        <skos:definition xml:lang="en">s-Hertogenbosch (Den Bosch, mint of Brabant, present-day municipality in the province of North Brabant, the Netherlands) possibly struck some anonymous coins in the 12th century. Under Philip II, the city received the right to mint small change in 1579, producing oorden and duiten (with a mintmark: tree). A fourth Brabantine mint was established there in 1581 and operated until 1624 under Philip II (1581–1598), Albert and Isabella (1599–1609, 1614–1621), and Philip IV (until 1624). During World War II, on 1 November 1943, camp money was issued at the Vught concentration camp, marked KONZENTRATIONSLAGER HERZOGENBUSCH (sometimes K.L.H.).</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Muntplaatsen"/>
        <geo:location rdf:resource="http://nomisma.org/id/s-hertogenbosch_nl#this"/>
