    <nmo:Mint rdf:about="http://nomisma.org/id/uden_nl">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <skos:prefLabel xml:lang="nl">Uden</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Uden</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Uden</skos:prefLabel>
        <skos:definition xml:lang="en">Uden, a municipality in North Brabant where, at the start of the First World War, a camp for Belgian refugees was opened under the name Vluchtoord Uden. At its peak, it housed between 7,000 and 8,000 residents. Residents who worked in one of the camp’s workshops were paid in the form of printed cards bearing the text ‘Vluchtoord Uden’ or ‘V.O. Uden’. These cards were denominated in the camp’s currency, the “punt”, and stamped with 'mayor' Jos. Systermans’ signature. Cards are also known with a value expressed as a service, such as “Shaving” and “Haircutting”. The “punt” was assigned a value of 2 cents. The camp currency had two issues. The first issue of twelve denominations suffered from counterfeiting, following which a second, also undated, issue of four denominations appeared. At the start of the Second World War, emergency currency was issued in denominations of 10, 15 and 20 guilders, of which no further examples are known.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Muntplaatsen"/>
        <geo:location rdf:resource="http://nomisma.org/id/uden_nl#this"/>
