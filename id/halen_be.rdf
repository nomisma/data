    <nmo:Mint rdf:about="http://nomisma.org/id/halen_be">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <skos:prefLabel xml:lang="nl">Halen</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Halen</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Halen</skos:prefLabel>
        <skos:definition xml:lang="en">Halen – Medieval mint town in the Duchy of Brabant, now a municipality in the Belgian province of Limburg. Coinage was issued there between 1235 and 1268 in the name of a Duke Henry, likely Henry II (1235–1248), Henry III (1248–1261), or during the regency of Aleidis of Burgundy for her minor son Henry IV (1261–1268). Minting resumed under John III (1312–1355). During the First World War, two series of emergency paper money was issued.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Papiergeldplaatsen"/>
        <geo:location rdf:resource="http://nomisma.org/id/halen_be#this"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/medieval_european_numismatics"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/modern_european_numismatics"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/medieval_belgian_numismatics"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/modern_belgian_numismatics"/>
        <skos:changeNote rdf:resource="http://nomisma.org/id/halen_be#provenance"/>
    </nmo:Mint>
   
   
   
