    <nmo:Mint rdf:about="http://nomisma.org/id/kessenich_be">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <skos:prefLabel xml:lang="nl">Kessenich</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Kessenich</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Kessenich</skos:prefLabel>
        <skos:definition xml:lang="en">Kessenich (former lordship, now part of Kinrooi in the province of Limburg, Belgium) included the villages of Kessenich and Kinrooi. According to Serrure, Count Ansfried, later bishop of Utrecht (995–1010), received minting rights at Kessenich in 964 from Emperor Otto I. Coinage occurred only in the 15th century at Kessenich and Kinrooi by lords of the House of Horn (descendants of Dirk Loef), producing imitations of local small change and, as excavations in 1972 showed, forgeries of French coinage from the reign of Charles VI (1380–1422).</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Muntplaatsen"/>
        <geo:location rdf:resource="http://nomisma.org/id/kessenich_be#this"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/medieval_european_numismatics"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/medieval_belgian_numismatics"/>
        <skos:changeNote rdf:resource="http://nomisma.org/id/kessenich_be#provenance"/>
    </nmo:Mint>
   
   
   
