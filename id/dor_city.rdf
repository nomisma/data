    <foaf:Organization rdf:about="http://nomisma.org/id/dor_city">
        <skos:scopeNote xml:lang="en">This concept should be used as an authority, to distinguish from nm:dora, which is to be used as a mint (place).</skos:scopeNote>
        <skos:prefLabel xml:lang="en">Dor</skos:prefLabel>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:definition xml:lang="en">Dor was a city in Phoenicia founded during the Bronze Age and lasted until the Byzantine period. It occasionally minted coinage under its own authority.</skos:definition>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <skos:changeNote rdf:resource="http://nomisma.org/id/dor_city#provenance"/>
        <skos:altLabel xml:lang="en">Dora</skos:altLabel>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/persian_numismatics"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/greek_numismatics"/>
    </foaf:Organization>
