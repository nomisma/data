    <nmo:Mint rdf:about="http://nomisma.org/id/hedel_nl">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <skos:prefLabel xml:lang="nl">Hedel</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Hedel</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Hedel</skos:prefLabel>
        <skos:definition xml:lang="en">Hedel (former lordship on the Maas in Gelderland, presen dat village in the municipaty of Maasdriel, the Netherlands) held minting rights under the lords and later counts of Bergh. Coinage occurred sporadically: briefly in the 15th century under Willem II, from 1565–1567 under Willem IV, and more substantially under Frederik van den Bergh from 1577–1580. Mint dies for his issues (stuiver, daalder, halve daalder) were rediscovered in 1981. Emergency notes were issued there at the start of World War II.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Muntplaatsen"/>
        <geo:location rdf:resource="http://nomisma.org/id/hedel_nl#this"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/medieval_european_numismatics"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/modern_european_numismatics"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/medieval_dutch_numismatics"/>
        <skos:changeNote rdf:resource="http://nomisma.org/id/hedel_nl#provenance"/>
    </nmo:Mint>
   
   
   
