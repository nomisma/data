    <nmo:Mint rdf:about="http://nomisma.org/id/oldeboorn_nl">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <skos:prefLabel xml:lang="nl">Oldeboorn</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Oldeboorn</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Oldeboorn</skos:prefLabel>
        <skos:definition xml:lang="en">Oldeboorn (Frisian: Aldeboarn), a Frisian mint located in the present municipality of Heerenveen, the Netherlands, where coins were minted by Egbert I (1057–1068). The mint is indicated on the coins as BORD, supplemented by NERE RERE; Brunonen.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Muntplaatsen"/>
