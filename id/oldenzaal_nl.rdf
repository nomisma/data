        <skos:prefLabel xml:lang="de">Oldenzaal</skos:prefLabel>
        <skos:definition xml:lang="en">Oldenzaal, a municipality in the province of Overijssel, where emergency paper money were designed at the beginning of World War II. The entire circulation was burned under supervision by order of the German occupying forces before being released into circulation.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Papiergeldplaatsen"/>
