        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/medieval_dutch_numismatics"/>
        <skos:changeNote rdf:resource="http://nomisma.org/id/kampen_fr#provenance"/>
    </nmo:Mint>
   
   
   
