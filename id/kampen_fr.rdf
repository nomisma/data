    <nmo:Mint rdf:about="http://nomisma.org/id/kampen_fr">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <skos:prefLabel xml:lang="nl">Kampen</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Kampen</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Kampen</skos:prefLabel>
        <skos:definition xml:lang="en">Kampen (mint city in the Dutch province of Overijssel, formerly part of the Oversticht) saw coinage by the Utrecht bishop Arnold van Hoorne (1371–1378) and later hosted a Burgundian royal mint opened in 1529 after the acquisition of the Oversticht by Charles V, active until 1535 (mintmark C on a cross). Reopened as a provincial mint in 1578 and moved to Kampen in 1582, it rotated nominally with Deventer and Zwolle until closing in 1805. As an imperial city, Kampen was granted minting rights in 1397, with urban issues from c. 1425 and cooperation with other Overijssel towns, including the joint “Drie Steden” mint (1534) moved to Kampen in 1583 and dissolved in 1588. A municipal mint operated again from 1590 to 1693, often naming the Holy Roman Emperor before aligning with Dutch practice; mint rights were surrendered in 1694. Emergency coinage was issued twice during the Eighty Years’ War (square silver pieces in 1578 and 1672), and emergency notes were put into circulation by the municipal Social Services in May 1940.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Muntplaatsen"/>
        <geo:location rdf:resource="http://nomisma.org/id/kampen_fr#this"/>
