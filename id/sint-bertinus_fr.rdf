        <skos:prefLabel xml:lang="en">Sint-Bertinus</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Sint-Bertinus</skos:prefLabel>
        <skos:definition xml:lang="en">Saint-Bertinus, an abbey in the Flemish town of Saint-Omer, where coins were minted in the 11th and 12th centuries by the Flemish counts and by the abbey itself.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Muntplaatsen"/>
