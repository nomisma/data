        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/modern_dutch_numismatics"/>
        <skos:changeNote rdf:resource="http://nomisma.org/id/raamsdonk_nl#provenance"/>
    </nmo:Mint>
   
   
   
