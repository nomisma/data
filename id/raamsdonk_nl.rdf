    <nmo:Mint rdf:about="http://nomisma.org/id/raamsdonk_nl">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <skos:prefLabel xml:lang="nl">Raamsdonk</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Raamsdonk</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Raamsdonk</skos:prefLabel>
        <skos:definition xml:lang="en">Raamsdonk, at that time a municipality in Holland, now a municipality in the province of North Brabant, where handwritten receipts were issued in 1795. These receipts could be exchanged for French assignats, issued by the French garrison during the siege of Geertruidenberg in the surrounding area. During the Second World War, emergency paper money of 1 guilder were issued with the date 13 May 1940.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Papiergeldplaatsen"/>
        <geo:location rdf:resource="http://nomisma.org/id/raamsdonk_nl#this"/>
