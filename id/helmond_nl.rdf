        <skos:prefLabel xml:lang="de">Helmond</skos:prefLabel>
        <skos:definition xml:lang="en">Helmond (municipality in the province of North Brabant, the Netherlands) issued emergency money at the beginning of World War II, both by “De gezamenlijke fabrikanten” and by the municipality itself (dated 16–30 May 1940).</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Papiergeldplaatsen"/>
