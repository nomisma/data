    <nmo:Collection rdf:about="http://nomisma.org/id/mahn">
        <skos:prefLabel xml:lang="en">Neuchâtel Museum of Art and History</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Museo d'arte e di storia di Neuchâtel</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Musée d'art et d'histoire de Neuchâtel</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Museum für Kunst und Geschichte Neuenburg</skos:prefLabel>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:definition xml:lang="en">The Neuchâtel Museum of Art and History (MahN) is a museum dedicated to history and fine arts, located in Neuchâtel, Switzerland. Its coin cabinet holds the largest public collection of Neuchâtel coinage, with over 1,900 coins issued by the county, later principality of Neuchâtel between the 14th century and the early 19th century. There is also a series of original dies used to mint these coins. In addition, the MahN holds a great part of the coins found from the canton's territory and has acquired coins and medals from various major private and public Neuchâtel collections.</skos:definition>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <foaf:homepage rdf:resource="https://www.mahn.ch/en/collections/detail/coins"/>
