    <nmo:Mint rdf:about="http://nomisma.org/id/saint-pol_fr">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <skos:prefLabel xml:lang="nl">Saint-Pol</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Saint-Pol</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Saint-Pol</skos:prefLabel>
        <skos:definition xml:lang="en">Saint-Pol, a former county now located in the French department of Pas-de-Calais, passed to the House of Luxembourg in 1360 through Mahaut de Chatillon, heiress of Saint-Pol and wife of Guy VI of Luxembourg, lord (1366–1367) and later Count of Ligny (1367–1371) and, as such, successor to his grandfather Walram II. Through the marriage of Anthony of Burgundy, Duke of Brabant (1406–1415), to Joan of Saint-Pol, the only child of Walram III, their son Philip of Saint-Pol, Duke of Brabant (1427–1430), inherited the county in 1415. Following his death without issue, Saint-Pol reverted to the House of Luxembourg, and Philip was succeeded by John III, a grandson of Guy VI. In the period 1292-1430, in Saint-Pol coins were produced.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Muntplaatsen"/>
