        <skos:prefLabel xml:lang="nl">Oosterhout</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Oosterhout</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Oosterhout</skos:prefLabel>
        <skos:definition xml:lang="en">Oosterhout, a municipality in the province of North Brabant, issued emergency banknotes of 25 cents, 1 guilder, and 2.5 guilders during the First World War, dated August 6, 1914. During the Second World War, a 1 guilder emergency banknote was issued, valid for two months and redeemable before July 15, 1940.</skos:definition>
        <dcterms:source rdf:resource="https://wiki.muntenenpapiergeld.nl/index.php?title=Papiergeldplaatsen"/>
